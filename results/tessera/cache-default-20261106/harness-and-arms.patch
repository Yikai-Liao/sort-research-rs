 mod engine;
 
 radix_adapter!("rust_tessera_stable_radix", |data| engine::sort(data));
+
+// Experiment arms: an identical copy of the engine measures code-placement
+// noise; the cached copy forces bucket-id caching for Copy records too.
+#[allow(unused_imports)]
+mod engine_copy;
+#[allow(unused_imports)]
+mod engine_cached;
+
+pub fn sort_copy<T: crate::other::radix_support::Key>(data: &mut [T]) {
+    engine_copy::sort(data)
+}
+
+pub fn sort_cached<T: crate::other::radix_support::Key>(data: &mut [T]) {
+    engine_cached::sort(data)
+}
